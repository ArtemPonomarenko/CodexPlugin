{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "azure-devops": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@azure-devops/mcp@2.11.0",
        "YOUR_ORGANIZATION",
        "-d",
        "core",
        "work",
        "work-items",
        "repositories",
        "pipelines",
        "search"
      ]
    }
  }
}
